{
	"name": "@inrixia/helpers",
	"version": "3.21.2",
	"description": "Helper functions for various projects",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./test": {
			"types": "./dist/test.d.ts",
			"default": "./dist/test.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"scripts": {
		"build": "rimraf dist && tsc",
		"prepare": "rimraf dist && tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:coverage:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=coverage/test-results.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write --end-of-line auto .",
		"updateSkills": "node .agents/update-skills.mjs"
	},
	"agentSkills": {
		"source": "Inrixia/.claude",
		"ref": "main",
		"skills": [
			"code-design",
			"review",
			"typescript",
			"vitest"
		]
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Inrixia/Helpers.git"
	},
	"author": "Inrix",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/Inrixia/Helpers/issues"
	},
	"homepage": "https://github.com/Inrixia/Helpers#readme",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.0.9",
		"@vitest/coverage-v8": "5.1.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"rimraf": "^6.1.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.74.0",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"dequal": "^2.0.3"
	}
}
